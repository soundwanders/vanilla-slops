# ---------------------------------------------------------------------------
# Copy to .env at the PROJECT ROOT (not inside src/) and fill in real values:
#
#     cp .env.example .env
#
# .env is gitignored and is the ONLY env file anything reads. Three loaders
# resolve the project root explicitly — src/server/config/secureConfig.js,
# src/server/instrument.js and src/server/scripts/verify-database.js — and the
# db:backup script reads the same path via node --env-file=.env. There is no
# NODE_ENV-based file selection and no envDir anywhere, so a .env.dev or a
# .env.prod would be read by nothing at all. Production configuration lives in
# the Vercel dashboard, not in a file in this repo.
# ---------------------------------------------------------------------------


# === Required — the server refuses to start without these ==================

# Supabase project URL. Validated on boot: must contain supabase.co.
SUPABASE_URL=https://your-project.supabase.co

# The legacy service_role JWT (starts with eyJ). NOT the anon key, and NOT the
# newer sb_secret_* format — @supabase/supabase-js v2 is built for JWTs.
# Validated on boot: must start with eyJ and be at least 100 characters.
# This key bypasses RLS. It belongs in this file and in the Vercel project env
# vars, and nowhere else.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...


# === Optional — each has a working default if unset ========================

# development | production | test. Defaults to development.
# Set production ONLY in the Vercel dashboard, never here.
NODE_ENV=development

# Express port. Defaults to 8000. Leave unset on Vercel — the serverless
# runtime assigns its own.
PORT=8000

# Comma-separated list of allowed origins. Outside production the CORS
# middleware allows every origin, so this is really a production setting.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Canonical site URL. Used for absolute URLs in the server-rendered game pages,
# the sitemap and the JSON-LD.
DOMAIN_URL=http://localhost:8000

# Sentry DSN. Leave empty to disable error reporting locally.
SENTRY_DSN=


# ---------------------------------------------------------------------------
# PRODUCTION — set these in the Vercel dashboard
# (Project → Settings → Environment Variables), not in any file here:
#
#     SUPABASE_URL                 same value as above
#     SUPABASE_SERVICE_ROLE_KEY    same value as above
#     NODE_ENV                     production
#     CORS_ORIGIN                  https://launchoptions.dev,https://www.launchoptions.dev
#     DOMAIN_URL                   https://launchoptions.dev
#     SENTRY_DSN                   the real DSN
#
# PORT is deliberately absent — the serverless runtime assigns it.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# BACKUPS — GitHub repository secrets. NOT this file, and NOT Vercel.
#
# .github/workflows/backup.yml is the only consumer of these two. No
# application code reads either one, so putting them in Vercel would hand the
# serverless function database credentials it has no use for.
#
#     SUPABASE_DB_URL     Supabase → Project Settings → Database → Connection
#                         string → SESSION POOLER (port 5432). The username is
#                         postgres.<project-ref>, not bare postgres. See
#                         docs/backups.md for why the direct connection
#                         resolves and then fails from CI.
#     BACKUP_PASSPHRASE   Any long random string. Keep it somewhere that is
#                         neither this repo nor the same place as the database
#                         password — a backup you cannot decrypt is not a
#                         backup.
#
# A copy of SUPABASE_DB_URL in your local .env is useful for running a dump or
# a restore by hand; it is never read by the running application.
# ---------------------------------------------------------------------------
