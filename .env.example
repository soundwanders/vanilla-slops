# Server Configuration
PORT=8000
NODE_ENV=development

# Game Fetch Limit
GAME_FETCH_LIMIT=100

# Supabase Configuration
# service_role only. The anon key is not used anywhere — the browser never
# talks to Supabase directly, every read goes through the Express API.
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# CORS Configuration (optional)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Domain URL
DOMAIN_URL=http://localhost:8000

# Error tracking (optional — omit to disable Sentry entirely)
SENTRY_DSN=
